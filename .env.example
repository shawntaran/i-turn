# Copy to .env and edit:   cp .env.example .env
# Or skip the editing:      python switch_ai.py colab --new   (paste the Colab banner)
#                           python switch_ai.py local
# Real environment variables override this file. Never commit .env.

# Where the AI server lives. This is the ONLY thing that changes between
# running the model on your own machine and running it in Google Colab.
#
#   Local AI server:   http://localhost:8001
#   Google Colab:      the https://xxxxx.trycloudflare.com URL the notebook prints
AI_BASE_URL=http://localhost:8001

# API key. The Colab notebook prints one for you; paste it here.
# Leave empty for a local server started without AI_API_KEY.
AI_API_KEY=

# Seconds to wait for one AI response.
AI_TIMEOUT=120

# Optional. Advisory model identifier sent with each request. The reference AI
# server answers with whichever model it loaded and ignores a mismatch.
AI_MODEL=

# --- Access to stored student data ---------------------------------------------
# The counsellor briefing, transcript, report, session-list and erase routes need
# this token, sent as:   Authorization: Bearer <token>
# With no token set they answer 503 (closed), never open. Use 16+ random
# characters; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ITURN_COUNSELLOR_TOKEN=

# Set to 1 to publish the interactive API docs at /docs (off by default).
ITURN_ENABLE_DOCS=
